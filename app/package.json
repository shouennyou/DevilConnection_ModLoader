    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "ISC",
  "homepage": "",
  "devDependencies": {
    "electron": "^22.0.0"
  },
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@electron/remote": "^2.0.9",
    "adm-zip": "^0.5.9",
    "fs-extra": "^11.1.0",
    "steamworks.js": "^0.4.0"
  },
  "extraResources": [
    "./node_modules/@electron/remote/**"
  ],
  "window": {
    "title": "DevilConnection",
    "icon": "link.png",
    "toolbar": false,
    "frame": true,
